# プロジェクト固有の private 領域（公開しないメモなど）
project-private/

# Node / Vite
node_modules/
dist/
*.local
npm-debug.log*

# Python（tools/ 配下の試作で使用）
__pycache__/
*.py[cod]
.venv/
tools/prototype/out/

# OS / エディタ
.DS_Store
Thumbs.db

# フォント実体は配布しない（生成ツールがローカルで使用。ライセンスは tools/prototype/README.md と docs/experiments/exp-3.md に記録）
tools/prototype/fonts/

# サンプルデータ
data/

# e2e テストの成果物（計測結果・Playwright の一時ファイル）
results/
test-results/
playwright-report/

# 実験コードの実行画像（out/montage/overlay には顔・自宅周辺の写真を含むため公開しない）
experiment/**/.venv*/
experiment/**/*.jpg
experiment/**/*.png
experiment/**/*.webm
experiment/**/*.mp4
